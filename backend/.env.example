# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/timetabling_db
TEST_DATABASE_URL=sqlite:///./test.db

# --- Auth ---
# Generate a long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed browser origins, or "*" for any (dev only).
# In production set this to your frontend URL, e.g. https://app.example.com
ALLOWED_ORIGINS=*

# --- Email delivery ---
# Leave SMTP_HOST empty to print emails to the console (dev). Set all SMTP_*
# values to send real activation / verification emails in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@timetabling.local
SMTP_USE_TLS=true

# Base URL the frontend is served from; used to build activation / confirm links.
APP_BASE_URL=http://localhost:8080

# Token lifetimes
ACTIVATION_TOKEN_DAYS=7
EMAIL_CHANGE_TOKEN_HOURS=24
